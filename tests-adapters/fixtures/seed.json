{
  "_comment": "Canonical content set. Every conformance target projects this into its own CMS; every contract assertion refers to it rather than to per-CMS literals. `type` values are canonical names \u2014 each target maps them to its CMS's real type via Target.types. Templates are CMS content, not frontend config: the frontend names one by path via allowedLayouts and the admin resolves it against whichever CMS is connected. Every target therefore has to carry the templates its frontend forces, or the editor never receives INITIAL_DATA and renders nothing at all.",
  "documents": [
    {
      "path": "/",
      "type": "folder",
      "title": "Home",
      "state": "published"
    },
    {
      "path": "/news",
      "type": "folder",
      "title": "News",
      "state": "published"
    },
    {
      "path": "/news/first-post",
      "type": "page",
      "title": "First Post",
      "state": "published",
      "blocks": {
        "b1": {
          "@type": "slate",
          "value": [
            {
              "type": "p",
              "children": [
                {
                  "text": "Hello"
                }
              ]
            }
          ]
        }
      },
      "blocksLayout": {
        "items": [
          "b1"
        ]
      }
    },
    {
      "path": "/news/draft-post",
      "type": "page",
      "title": "Draft Post",
      "state": "draft",
      "blocks": {},
      "blocksLayout": {
        "items": []
      }
    },
    {
      "path": "/about",
      "type": "page",
      "title": "About",
      "state": "published",
      "blocks": {},
      "blocksLayout": {
        "items": []
      }
    },
    {
      "path": "/templates",
      "type": "folder",
      "title": "Templates",
      "state": "published",
      "blocks": {},
      "blocksLayout": {
        "items": []
      }
    },
    {
      "path": "/templates/context-navigation-layout",
      "type": "page",
      "title": "Context Navigation Layout",
      "state": "published",
      "blocks": {
        "tpl-context-nav": {
          "@type": "contextNavigation",
          "fixed": true,
          "readOnly": true,
          "templateId": "/templates/context-navigation-layout",
          "templateInstanceId": "context-navigation-layout-def-instance",
          "slotId": "context-navigation",
          "ariaLabel": "In this section",
          "blocks": {
            "tpl-cnav-listing": {
              "@type": "listing",
              "variation": "navItem",
              "fixed": true,
              "readOnly": true,
              "templateId": "/templates/context-navigation-layout",
              "templateInstanceId": "context-navigation-layout-def-instance",
              "slotId": "context-navigation-listing",
              "fieldMapping": {
                "@id": {
                  "field": "href",
                  "type": "link"
                },
                "title": {
                  "field": "label"
                }
              },
              "querystring": {
                "query": [
                  {
                    "i": "path",
                    "o": "plone.app.querystring.operation.string.relativePath",
                    "v": ".."
                  },
                  {
                    "i": "portal_type",
                    "o": "plone.app.querystring.operation.selection.none",
                    "v": [
                      "Image",
                      "File"
                    ]
                  },
                  {
                    "i": "exclude_from_nav",
                    "o": "plone.app.querystring.operation.boolean.isFalse",
                    "v": ""
                  }
                ],
                "sort_on": "getObjPositionInParent",
                "depth": 4
              }
            }
          },
          "blocks_layout": {
            "items": [
              "tpl-cnav-listing"
            ]
          }
        },
        "tpl-default-slot": {
          "@type": "slate",
          "templateId": "/templates/context-navigation-layout",
          "templateInstanceId": "context-navigation-layout-def-instance",
          "slotId": "default",
          "value": [
            {
              "type": "p",
              "children": [
                {
                  "text": ""
                }
              ]
            }
          ],
          "plaintext": ""
        }
      },
      "blocksLayout": {
        "items": [
          "tpl-context-nav",
          "tpl-default-slot"
        ]
      }
    }
  ],
  "assets": [
    {
      "path": "/news/hero.png",
      "type": "image",
      "title": "Hero",
      "width": 800,
      "height": 600
    }
  ],
  "vocabularies": {
    "categories": {
      "generate": 10000,
      "tokenPrefix": "cat-",
      "titlePrefix": "Category "
    }
  },
  "users": [
    {
      "username": "admin",
      "fullname": "Site Admin",
      "roles": [
        "Manager"
      ]
    }
  ]
}
