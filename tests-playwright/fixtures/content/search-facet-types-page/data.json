{
  "@id": "http://localhost:8888/_test_data/search-facet-types-page",
  "@type": "Document",
  "UID": "search-facet-types-page-uid",
  "id": "search-facet-types-page",
  "title": "Search Facet Types",
  "description": "The facet types the main search fixture does not use, so every registered facet type has an editable example.",
  "review_state": "published",
  "blocks": {
    "title-1": {
      "@type": "title"
    },
    "search-1": {
      "@type": "search",
      "headline": "Search Content",
      "showSearchInput": true,
      "showSortOn": true,
      "showTotalResults": true,
      "sortOnOptions": [
        "effective",
        "created",
        "sortable_title"
      ],
      "blocks": {
        "results-listing": {
          "@type": "listing",
          "variation": "teaser",
          "fieldMapping": {
            "@id": {
              "field": "href",
              "type": "link"
            },
            "title": "title",
            "description": "description",
            "image": "preview_image"
          },
          "querystring": {
            "query": [
              {
                "i": "portal_type",
                "o": "plone.app.querystring.operation.selection.any",
                "v": [
                  "Document"
                ]
              }
            ],
            "sort_on": "effective",
            "sort_order": "descending"
          }
        }
      },
      "blocks_layout": {
        "listing": [
          "results-listing"
        ]
      },
      "facets": [
        {
          "@id": "facet-created",
          "title": "Created",
          "field": "created",
          "type": "daterangeFacet"
        },
        {
          "@id": "facet-images",
          "title": "Has image",
          "field": "hasPreviewImage",
          "type": "toggleFacet"
        }
      ]
    }
  },
  "blocks_layout": {
    "items": [
      "title-1",
      "search-1"
    ]
  }
}
